import os

def genera_sitemap():
    base_url = "https://www.tempestivo.it/"
    cartella_pagine = "pagine_generate"
    
    if not os.path.exists(cartella_pagine):
        print("Cartella pagine non trovata.")
        return

    xml_content = '<?xml version="1.0" encoding="UTF-8"?>\n'
    xml_content += '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
    
    # Aggiungi la index principale
    xml_content += f'  <url>\n    <loc>{base_url}index.html</loc>\n    <priority>1.0</priority>\n  </url>\n'

    # Trova tutti i file html generati
    for file in os.listdir(cartella_pagine):
        if file.endswith(".html"):
            xml_content += f'  <url>\n    <loc>{base_url}{file}</loc>\n    <priority>0.8</priority>\n  </url>\n'
            
    xml_content += '</urlset>'
    
    with open("sitemap.xml", "w", encoding="utf-8") as f:
        f.write(xml_content)
    print("File sitemap.xml generato con successo!")

if __name__ == "__main__":
    genera_sitemap()