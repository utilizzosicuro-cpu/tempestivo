# Torre Pozzillo e' nel comune di Cinisi (P2)
<IfModule mod_alias.c>
  RedirectMatch 301 ^/carini/torre-pozzillo/elettricista/$ /cinisi/torre-pozzillo/elettricista/
  RedirectMatch 301 ^/carini/torre-pozzillo/idraulico/$ /cinisi/torre-pozzillo/idraulico/
</IfModule>
# Redirect 301 degli slug normalizzati (P2)
<IfModule mod_alias.c>
  RedirectMatch 301 ^/terrasini/ristrutturazione_completa_terrasini/$ /terrasini/ristrutturazione-terrasini/
  RedirectMatch 301 ^/alcamo/alcamo\-marina/ristrutturazione\-bagno/ristrutturazione\-bagno\-alcamo\-marina\.html$ /alcamo/alcamo-marina/ristrutturazione-bagno/
</IfModule>

